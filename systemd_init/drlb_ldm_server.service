[Unit]
Description=DataReel LDM load balancer
Documentation=man:drlb_ldm_server(8)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
LimitNOFILE=65535
Environment=CFGFILE=/etc/drlb/ldm_cluster.cfg ARGS=
EnvironmentFile=-/etc/sysconfig/drlb_ldm_server
ExecStartPre=/usr/libexec/drlb/drlb_platform_check
ExecStart=/usr/sbin/drlb_ldm_server --config-file=${CFGFILE} $ARGS
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
