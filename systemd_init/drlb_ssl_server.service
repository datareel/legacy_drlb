[Unit]
Description=DataReel SSL bridge
Documentation=man:drlb_ssl_server(8)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
LimitNOFILE=65535
Environment=CFGFILE=/etc/drlb/ssl_bridge.cfg ARGS=
EnvironmentFile=-/etc/sysconfig/drlb_ssl_server
ExecStartPre=/usr/libexec/drlb/drlb_platform_check
ExecStart=/usr/sbin/drlb_ssl_server --config-file=${CFGFILE} $ARGS
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
